# Tésera — variables de entorno. Copiar a .env.local (nunca commitear .env*).
# Validación: src/lib/env.ts. Los valores reales de prod/preview viven solo en Vercel.

# ── App ───────────────────────────────────────────────
SITE_URL=http://localhost:3000

# ── Base de datos (Neon / Supabase) ───────────────────
# DATABASE_URL: conexión con pooler (runtime). DIRECT_URL: conexión directa (migraciones).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# ── SexShopMayorista (Fase 3) ─────────────────────────
SM_API_BASE_URL=https://www.sexshopmayorista.com
SM_API_KEY=

# ── Mercado Pago (Fase 5) ─────────────────────────────
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Solo si se usa Bricks (única variable pública permitida)
NEXT_PUBLIC_MP_PUBLIC_KEY=

# ── Transferencia (Fase 5) ────────────────────────────
TRANSFER_ALIAS=
TRANSFER_CBU=
TRANSFER_HOLDER=

# ── Emails (Fase 8) y comprobantes (Fase 5) ───────────
RESEND_API_KEY=
BLOB_READ_WRITE_TOKEN=

# ── Cron (Vercel manda Authorization: Bearer $CRON_SECRET) ──
CRON_SECRET=

# ── Auth del panel (Fase 7) ───────────────────────────
# TODO(brai): se define en la Fase 7 (proveedor de auth y allowlist).
